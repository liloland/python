create a new repo

echo "# python" >> README.md
git init
git add README.md
git commit -m "first commit"
git branch -M main
git remote add origin git@github.com:liloland/python.git
git push -u origin main


or push an existing repo
git remote add origin git@github.com:liloland/python.git
git branch -M main
git push -u origin main


create a new branch
git checkout -b first_branch
